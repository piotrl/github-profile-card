{
  "name": "github-profile-card",
  "version": "3.2.0",
  "description": "Widget for presenting your GitHub profile on your website. Pure JavaScript.",
  "main": "dist/gh-profile-card.min.js",
  "type": "module",
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "oxlint": "1.91.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vitest": "5.1.0"
  },
  "scripts": {
    "build": "node build.js",
    "build:check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write --ignore-unknown {*,src/*,demo/*}",
    "format:check": "prettier --check --ignore-unknown {*,src/*,demo/*}",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/piotrl/github-profile-card.git"
  },
  "keywords": [
    "github",
    "widget",
    "vanilla",
    "javascript",
    "browser"
  ],
  "author": "Piotr Lewandowski",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/piotrl/github-profile-card/issues"
  },
  "homepage": "https://piotrl.github.io/github-profile-card/"
}
